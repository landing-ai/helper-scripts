# LandingAI API Configuration
# Copy this file to .env and fill in your actual credentials

# Required: Your LandingAI API key
LANDINGAI_API_KEY=your_api_key_here

# Required: Your LandingAI endpoint ID
LANDINGAI_ENDPOINT=your_endpoint_id_here

# Optional: Request timeout in seconds (default: 60)
#SEGMENTATION_TIMEOUT=60

# Optional: Maximum number of retries (default: 3)
#SEGMENTATION_MAX_RETRIES=3

# Optional: Default output format - json or csv (default: json)
#SEGMENTATION_OUTPUT_FORMAT=json

# Optional: Visualization figure size (default: 15x8)
#SEGMENTATION_FIG_WIDTH=15
#SEGMENTATION_FIG_HEIGHT=8